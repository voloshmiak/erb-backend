{
    "swagger": "2.0",
    "info": {
        "description": "This is the API documentation for the Empty Runner Buster application",
        "title": "Empty Runner Buster API",
        "contact": {},
        "version": "1.0.1"
    },
    "basePath": "/api",
    "paths": {
        "/health": {
            "get": {
                "description": "Checks the health of the API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health Check",
                "responses": {}
            }
        },
        "/stations": {
            "get": {
                "description": "Retrieves all stations and active edges forming the railway graph",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Station"
                ],
                "summary": "List Stations",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.listStationsResponse"
                        }
                    },
                    "500": {
                        "description": "Failed to retrieve stations",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controller.edgeResponse": {
            "type": "object",
            "properties": {
                "distanceKm": {
                    "type": "integer"
                },
                "from": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                }
            }
        },
        "controller.listStationsResponse": {
            "type": "object",
            "properties": {
                "edges": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.edgeResponse"
                    }
                },
                "stations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.stationResponse"
                    }
                }
            }
        },
        "controller.stationResponse": {
            "type": "object",
            "properties": {
                "lat": {
                    "type": "number"
                },
                "lng": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                },
                "stationId": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        }
    }
}